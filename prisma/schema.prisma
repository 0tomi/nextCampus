// Campus Estudiantil — esquema de datos (sigue docs/prompts/init.md)
// Prisma 7: generator `prisma-client` + driver adapter (@prisma/adapter-pg).

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  // Mantener el cliente generado fuera de `src`: Next/Turbopack no debe
  // observar ni compilar miles de líneas generadas como parte del frontend.
  output   = "./generated/client"
}

/// Carrera. Scope fijo: una sola carrera (Lic. en Sistemas), cargada por seed.
model Career {
  id          String        @id @default(cuid())
  slug        String        @unique
  nombre      String
  descripcion String        @default("")
  years       AcademicYear[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AcademicYear {
  id          String    @id @default(cuid())
  career      Career    @relation(fields: [careerId], references: [id], onDelete: Cascade)
  careerId    String
  slug        String    @unique
  nombre      String
  descripcion String    @default("")
  orden       Int
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([careerId])
}

model Subject {
  id          String       @id @default(cuid())
  year        AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  yearId      String
  slug        String       @unique
  nombre      String
  descripcion String       @default("")
  agenda      Agenda?
  apuntes     Apunte[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([yearId])
}

// ---------------------------------------------------------------------------
// Calendario: Agenda (1:1 materia) -> Evento -> TipoEvento
// ---------------------------------------------------------------------------

model Agenda {
  id        String   @id @default(cuid())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String   @unique
  eventos   Evento[]
  createdAt DateTime @default(now())
}

/// Tipo de evento. Seed: Examen, Trabajo Práctico, Exposición. Expandible.
model TipoEvento {
  id      String   @id @default(cuid())
  slug    String   @unique
  nombre  String
  eventos Evento[]
}

model Evento {
  id           String     @id @default(cuid())
  agenda       Agenda     @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  agendaId     String
  tipoEvento   TipoEvento @relation(fields: [tipoEventoId], references: [id], onDelete: Restrict)
  tipoEventoId String
  titulo       String
  /// HTML enriquecido y SANITIZADO (hipervínculos, formato). Nunca crudo.
  descripcionHtml String  @default("")
  fecha        DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([agendaId])
  @@index([tipoEventoId])
}

// ---------------------------------------------------------------------------
// Quiz: ya NO vive en la base de datos. Los bancos de preguntas son JSON
// privados en Supabase Storage (quizzes/{anio}/{materia}/{uuid}.json) con un
// manifest index.json por materia. Ver src/lib/storage.ts y
// src/lib/domain/quiz-bank.ts. La corrección es siempre server-side.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Apuntes: materia -> Apunte (PDF en Supabase Storage o solo descripción)
// ---------------------------------------------------------------------------

model Apunte {
  id          String   @id @default(cuid())
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   String
  titulo      String
  /// HTML enriquecido y SANITIZADO (links a Drive/Docs, formato).
  descripcionHtml String @default("")
  /// Object key del PDF en Supabase Storage (bucket `apuntes`). Null = sin PDF.
  pdfObjectKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subjectId])
}

// Admins: NO hay tabla. La autorización vive en la capa de servidor de Next
// (middleware + server actions verifican supabase.auth.getUser() y chequean
// el email contra la allowlist ADMIN_EMAILS). Sin signup público.
