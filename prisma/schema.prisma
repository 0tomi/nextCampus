// Campus Estudiantil — esquema de datos (sigue docs/prompts/init.md)
// Prisma 7: generator `prisma-client` + driver adapter (@prisma/adapter-pg).

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  // Mantener el cliente generado fuera de `src`: Next/Turbopack no debe
  // observar ni compilar miles de líneas generadas como parte del frontend.
  output   = "./generated/client"
}

/// Carrera. Scope fijo: una sola carrera (Lic. en Sistemas), cargada por seed.
model Career {
  id          String         @id @default(cuid())
  slug        String         @unique
  nombre      String
  descripcion String         @default("")
  years       AcademicYear[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AcademicYear {
  id               String               @id @default(cuid())
  career           Career               @relation(fields: [careerId], references: [id], onDelete: Cascade)
  careerId         String
  slug             String               @unique
  nombre           String
  descripcion      String               @default("")
  driveUrl         String?
  playlistUrl      String?
  playlistEnabled  Boolean              @default(false)
  discordUrl            String?
  discordDescripcion    String?
  discordAltUrl         String?
  discordAltDescripcion String?
  orden            Int
  color            String?
  subjects         Subject[]
  adminPermissions UserYearPermission[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([careerId])
}

enum UserRole {
  ADMIN
  SUPERVISOR
  AYUDANTE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model UserAccount {
  id                     String               @id @default(cuid())
  authUserId             String               @unique
  email                  String               @unique
  role                   UserRole
  status                 UserStatus           @default(ACTIVE)
  yearPermissions        UserYearPermission[]
  nombreUsuario          String
  puntaje                Int                  @default(0)
  eventosCreados         Int                  @default(0)
  apuntesCreados         Int                  @default(0)
  bancosPreguntasCreados Int                  @default(0)
  auditLogs              AuditLog[]
  eventos                Evento[]             @relation("EventoCreatedBy")
  periodos               PeriodoAcademico[]   @relation("PeriodoCreatedBy")
  apuntes                Apunte[]             @relation("ApunteCreatedBy")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([role])
  @@index([status])
  @@index([puntaje])
}

model UserYearPermission {
  user      UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  year      AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  yearId    String
  createdAt DateTime     @default(now())

  @@id([userId, yearId])
  @@index([yearId])
}

model Subject {
  id                 String              @id @default(cuid())
  year               AcademicYear        @relation(fields: [yearId], references: [id], onDelete: Cascade)
  yearId             String
  slug               String              @unique
  nombre             String
  descripcion        String              @default("")
  driveUrl           String?
  playlistUrl        String?
  playlistEnabled    Boolean             @default(false)
  commissions        Commission[]
  agendas            Agenda[]
  apuntes            Apunte[]
  rankedQuizAttempts RankedQuizAttempt[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([yearId])
}

// ---------------------------------------------------------------------------
// Calendario: Agenda (general o específica por comisión) -> Evento -> TipoEvento
// ---------------------------------------------------------------------------

model Commission {
  id        String   @id @default(cuid())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  slug      String
  nombre    String
  agenda    Agenda?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId, createdAt, id])
  @@index([subjectId])
}

model Agenda {
  id           String      @id @default(cuid())
  subject      Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId    String
  commission   Commission? @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  commissionId String?     @unique
  eventos      Evento[]
  createdAt    DateTime    @default(now())

  @@index([subjectId])
}

/// Tipo de evento. Seed: Examen, Trabajo Práctico, Exposición. Expandible.
model TipoEvento {
  id      String   @id @default(cuid())
  slug    String   @unique
  nombre  String
  eventos Evento[]
}

model Evento {
  id              String         @id @default(cuid())
  agenda          Agenda         @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  agendaId        String
  tipoEvento      TipoEvento     @relation(fields: [tipoEventoId], references: [id], onDelete: Restrict)
  tipoEventoId    String
  titulo          String
  /// HTML enriquecido y SANITIZADO (hipervínculos, formato). Nunca crudo.
  descripcionHtml String         @default("")
  /// Solo fecha (sin hora). La hora vive aparte y es opcional.
  fecha           DateTime       @db.Date
  /// Hora opcional en formato "HH:mm" (24h). null = evento sin hora definida.
  hora            String?
  createdAt       DateTime       @default(now())
  createdBy       UserAccount?   @relation("EventoCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  apuntes         ApunteEvento[]
  updatedAt       DateTime       @updatedAt

  @@index([agendaId])
  @@index([tipoEventoId])
  @@index([createdByUserId])
}

/// Categoría de período académico. Define el color por código (ver src/lib/periodos.ts).
/// Expandible para el resto del calendario FCYT (feriados, inscripciones, etc.).
enum CategoriaPeriodo {
  SUSPENSION_CLASES
  MESAS_EXAMEN
}

/// Período académico de la facultad (global, no cuelga de ninguna materia).
/// Se renderiza pintando el fondo de los días del calendario, no como evento.
model PeriodoAcademico {
  id              String           @id @default(cuid())
  categoria       CategoriaPeriodo
  titulo          String
  /// Solo fecha (sin hora). Medianoche UTC, igual que Evento.fecha.
  fechaInicio     DateTime         @db.Date
  /// Fecha final inclusiva. Un solo día => fechaFin == fechaInicio.
  fechaFin        DateTime         @db.Date
  createdBy       UserAccount?     @relation("PeriodoCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([fechaInicio, fechaFin])
  @@index([createdByUserId])
}

enum RankedQuizAttemptStatus {
  IN_PROGRESS
  VALID
  INVALID
}

model RankedQuizAttempt {
  id              String                  @id @default(cuid())
  subject         Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId       String
  bankId          String
  bankName        String
  participantName String
  normalizedName  String
  questionIds     String[]
  status          RankedQuizAttemptStatus @default(IN_PROGRESS)
  invalidReason   String?
  invalidatedAt   DateTime?
  correctAnswers  Int?
  totalQuestions  Int
  percentage      Int?
  durationSeconds Int?
  startedAt       DateTime                @default(now())
  finishedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([subjectId, bankId, status, percentage, durationSeconds, finishedAt], map: "RankedQuizAttempt_top_idx")
  @@index([subjectId, bankId, normalizedName], map: "RankedQuizAttempt_name_idx")
  @@index([status, finishedAt], map: "RankedQuizAttempt_status_idx")
}

// ---------------------------------------------------------------------------
// Quiz: ya NO vive en la base de datos. Los bancos de preguntas son JSON
// privados en Supabase Storage (quizzes/{anio}/{materia}/{uuid}.json) con un
// manifest index.json por materia. Ver src/lib/storage.ts y
// src/lib/domain/quiz-bank.ts. La corrección es siempre server-side.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Apuntes: materia -> Apunte (rich text + recursos YouTube/Drive ordenables)
// ---------------------------------------------------------------------------

enum RecursoTipo {
  YOUTUBE
  DRIVE
  HTML
}

model Apunte {
  id              String            @id @default(cuid())
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId       String
  titulo          String
  slug            String
  /// HTML enriquecido y SANITIZADO (links a Drive/Docs, formato).
  descripcionHtml String            @default("")
  recursos        ApunteRecurso[]
  categorias      ApunteCategoria[]
  eventos         ApunteEvento[]
  createdBy       UserAccount?      @relation("ApunteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId, createdAt, id])
  @@index([subjectId])
  @@index([createdByUserId])
}

model Categoria {
  id        String            @id @default(cuid())
  nombre    String            @unique
  apuntes   ApunteCategoria[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ApunteCategoria {
  apunte      Apunte    @relation(fields: [apunteId], references: [id], onDelete: Cascade)
  apunteId    String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  categoriaId String
  createdAt   DateTime  @default(now())

  @@id([apunteId, categoriaId])
  @@index([categoriaId, apunteId])
}

model ApunteEvento {
  apunte    Apunte   @relation(fields: [apunteId], references: [id], onDelete: Cascade)
  apunteId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  eventoId  String
  createdAt DateTime @default(now())

  @@id([apunteId, eventoId])
  @@index([eventoId])
  @@index([apunteId])
}

model ApunteRecurso {
  id         String      @id @default(cuid())
  apunte     Apunte      @relation(fields: [apunteId], references: [id], onDelete: Cascade)
  apunteId   String
  tipo       RecursoTipo
  url        String      @default("")
  nombre     String?
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
  orden      Int         @db.SmallInt
  createdAt  DateTime    @default(now())

  @@unique([apunteId, orden])
  @@index([apunteId])
}

// Admins: ADMIN_EMAILS sigue siendo el bootstrap de Admin.
// Supervisor/Ayudante viven en UserAccount con permisos explícitos por año.
// Sin signup público.

// ---------------------------------------------------------------------------
// Auditoría: cada movimiento administrativo deja una entrada con quién, qué
// y cuándo. `detail` guarda un snapshot del payload (nombres, slugs, ids) para
// que el renderer pueda mostrar contexto humano aun si la entidad se borra.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     String
  action     String
  entityType String?
  entityId   String?
  yearId     String?
  yearSlug   String?
  detail     Json
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([yearId, createdAt, id])
  @@index([yearSlug])
  @@index([createdAt])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@index([action, createdAt, id])
  @@map("audit_logs")
}
