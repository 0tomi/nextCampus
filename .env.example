# Runtime: Transaction pooler (pgbouncer) — puerto 6543
# El query string ?pgbouncer=true&connection_limit=1 es OBLIGATORIO en serverless
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migraciones / seed: conexión directa — puerto 5432
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"

# Project Settings → API → Publishable key (antes: anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# Project Settings → API → Secret key (antes: service_role) — NUNCA en NEXT_PUBLIC_*, solo server-side
SUPABASE_SECRET_KEY="<secret-key>"

# Nombre del bucket de Storage (crear en Supabase como privado)
SUPABASE_STORAGE_BUCKET="apuntes"

# Emails de administradores separados por coma, en minúscula
ADMIN_EMAILS="admin@ejemplo.com"

# Rate limiting (opcional, recomendado en prod)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
